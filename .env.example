# Copy to .env (yarn setup does it). Values with spaces must be quoted.
COMPOSE_PROJECT_NAME=caqui-chatbot
NODE_ENV=development

API_PORT=3000
WEB_PORT=5174
API_URL=http://localhost:3000
WEB_URL=http://localhost:5174
VITE_API_URL=http://localhost:3000

# SQLite file. Relative paths are resolved against the repo root. Containers override it to /app/data/...
DATABASE_PATH=./data/caqui-chatbot.db

# Better Auth. Change the secret outside local development (min 32 chars).
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

# Test user created by `yarn db:seed` and used by Playwright
SEED_USER_EMAIL=test@caqui.dev
SEED_USER_PASSWORD=caqui-test-123
SEED_USER_NAME="Test User"

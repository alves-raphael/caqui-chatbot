# Fill secret values locally; never commit the resulting .env.docker.
NODE_ENV=production
CAQUI_PUBLIC_DEMO=true
API_PORT=3000
WEB_URL=http://localhost:8080
BETTER_AUTH_URL=http://localhost:8080
DATABASE_PATH=/app/data/caqui-chatbot.db
CAQUI_LEDGER_PATH=/app/data/openrouter-usage.jsonl

# Minimum 16 characters, generated randomly. Browser username is demo.
CAQUI_DEMO_ACCESS_CODE=
# Minimum 32 characters; legacy auth routes are disabled in public-demo mode.
BETTER_AUTH_SECRET=
SEED_USER_EMAIL=demo@example.invalid
SEED_USER_PASSWORD=unused-in-public-demo
SEED_USER_NAME=Demo

# Server only: never VITE_OPENROUTER_API_KEY and never a Docker build argument.
OPENROUTER_API_KEY=
CAQUI_LIVE_AI_ENABLED=false
CAQUI_TEST_BUDGET_USD=5
# Reserve the entire maximum of this task's local instance (100 x $0.03).
# This leaves at most $1.98 of new reservations in one public instance.
CAQUI_PREVIOUS_RESERVED_USD=3

{
  "name": "caqui-chatbot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "wait-on": "^9.5.1"
  },
  "scripts": {
    "dev": "yarn workspaces foreach -Api run dev",
    "dev:logged": "node scripts/dev-logged.mjs",
    "build": "yarn workspaces foreach -Ap run build",
    "lint": "eslint . && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "typecheck": "yarn workspaces foreach -Ap run typecheck",
    "test": "yarn workspaces foreach -Ap run test",
    "e2e": "yarn workspace @caqui-chatbot/web e2e",
    "db:generate": "yarn workspace @caqui-chatbot/api db:generate",
    "db:migrate": "yarn workspace @caqui-chatbot/api db:migrate",
    "db:seed": "yarn workspace @caqui-chatbot/api db:seed",
    "api:openapi": "yarn workspace @caqui-chatbot/api api:openapi",
    "setup": "node scripts/setup.mjs",
    "status": "node scripts/status.mjs",
    "verify": "yarn typecheck && yarn lint && yarn test && yarn api:openapi --check",
    "postinstall": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,html}": "prettier --write"
  }
}
